# Postman MCP Integration - Environment Variables Template
# Copy to .env.postman and fill in your values
# DO NOT commit .env.postman to version control

# ========================================
# POSTMAN API CONFIGURATION
# ========================================

# Your Postman API Key (PMAK-...)
# Get it from: https://web.postman.co/settings/me/api-keys
# ⚠️  KEEP THIS SECURE - Never share or commit
POSTMAN_API_KEY=PMAK-REPLACE_WITH_YOUR_API_KEY

# Postman API Base URL (usually stays the same)
POSTMAN_BASE_URL=https://api.postman.com

# ========================================
# MCP SERVER CONFIGURATION
# ========================================

# VS Code MCP Server host (localhost for local development)
MCP_SERVER_HOST=localhost

# VS Code MCP Server port
MCP_SERVER_PORT=3000

# ========================================
# INTEGRATION SETTINGS
# ========================================

# Enable debug logging for MCP-Postman bridge
DEBUG_MCP_POSTMAN=false

# Timeout for API requests (milliseconds)
API_REQUEST_TIMEOUT=5000

# ========================================
# DATABASE CONNECTIONS (existing)
# ========================================

# MongoDB
MONGODB_URI=mongodb://username:password@localhost:27017/

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=Givenchicodes
MYSQL_PASSWORD=
# Note: Use VS Code secret storage for passwords, not plain text

# ========================================
# DOCKER ENVIRONMENT
# ========================================

# Docker registry (if using private registries)
DOCKER_REGISTRY=

# Docker environment (development/staging/production)
DOCKER_ENV=development

# ========================================
# SECURITY & LOGGING
# ========================================

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Enable secure HTTPS only (for production)
SECURE_HTTPS_ONLY=false

# Node environment
NODE_ENV=development
